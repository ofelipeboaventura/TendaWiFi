{
  "name": "tenda-wifi-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Painel local para Tenda RX27 Pro",
  "author": "TendaWiFi local project",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win portable --x64",
    "start": "electron .",
    "research": "node scripts/report-firmware.mjs",
    "test:desktop": "npm run build && node scripts/run-smoke.mjs",
    "diagnose:login": "node scripts/diagnose-login.mjs",
    "diagnose:env": "node scripts/diagnose-env.mjs"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "local.tendawifi.desktop",
    "productName": "Tenda WiFi Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main.cjs",
      "out/preload.cjs",
      "out/monitoring-worker.cjs",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "TendaWiFi-${version}-win-x64.exe",
      "requestExecutionLevel": "user"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "enableCookieEncryption": true
    }
  }
}
